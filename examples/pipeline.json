{
  "$schema": "https://richardrh.github.io/valet/schema/v1/pipeline.schema.json",
  "name": "Test Pipeline",
  "version": "1.0",
  "rules": [
    {
      "code": "RECORD_ID_REQUIRED",
      "name": "Record ID must not be null",
      "column": "record_id",
      "checks": {"not_null": true},
      "level": "error",
      "message": "record_id is required"
    },
    {
      "code": "AMOUNT_RANGE",
      "name": "Amount should be reasonable",
      "column": "amount",
      "checks": {"valid_range": {"min": 0, "max": 10000000}},
      "level": "error",
      "message": "amount must be between 0 and 10,000,000"
    },
    {
      "code": "LOCATION_REQUIRED",
      "name": "Location is required",
      "column": "location",
      "checks": {"not_null": true},
      "level": "warn"
    },
    {
      "code": "POSITIVE_AMOUNT",
      "name": "Amount must be positive",
      "column": "amount",
      "checks": {"valid_range": {"min": 0}},
      "level": "error",
      "message": "amount must be positive"
    }
  ]
}
